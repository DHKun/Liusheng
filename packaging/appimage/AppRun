#!/usr/bin/env bash
set -euo pipefail
# Keep the caller's working directory so relative file arguments retain meaning.
APPDIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
export APPDIR
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="$APPDIR/usr/plugins"
export QT_QPA_PLATFORM_PLUGIN_PATH="$APPDIR/usr/plugins/platforms"
export QML_IMPORT_PATH="$APPDIR/usr/qml"
export QML2_IMPORT_PATH="$APPDIR/usr/qml"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
# Load client modules matching the bundled PipeWire library. The host continues
# to own the audio server, session manager, runtime socket and hardware devices.
export SPA_PLUGIN_DIR="$APPDIR/usr/lib/spa-0.2"
export PIPEWIRE_MODULE_DIR="$APPDIR/usr/lib/pipewire-0.3"
export PIPEWIRE_CONFIG_DIR="${PIPEWIRE_CONFIG_DIR:-$APPDIR/usr/share/pipewire}"
export ALSA_CONFIG_DIR="${ALSA_CONFIG_DIR:-$APPDIR/usr/share/alsa}"
# ALSA treats spaces and colons as config-list delimiters. An inherited file
# descriptor provides a delimiter-free path while the bundle can live anywhere.
# The descriptor belongs to this process and is closed by the OS on exit.
if [[ -z ${ALSA_CONFIG_PATH:-} ]]; then
    if [[ "$ALSA_CONFIG_DIR" == *' '* || "$ALSA_CONFIG_DIR" == *':'* ]]; then
        exec {alsa_config_fd}< "$ALSA_CONFIG_DIR/alsa.conf"
        export ALSA_CONFIG_PATH="/proc/self/fd/$alsa_config_fd"
    else
        export ALSA_CONFIG_PATH="$ALSA_CONFIG_DIR/alsa.conf"
    fi
fi
# Explicit caller selection is honored. Wayland remains the default on Wayland.
if [[ -z ${QT_QPA_PLATFORM:-} && -n ${WAYLAND_DISPLAY:-} ]]; then
    export QT_QPA_PLATFORM='wayland;xcb'
fi
exec "$APPDIR/usr/bin/liusheng" "$@"
