px&quot;&gt;receiver → qt_thread.queue&lt;/div&gt;&lt;div&gt;服务接收器由桥接线程监听&lt;/div&gt;&lt;div&gt;返回 GUI 后检查请求有效性&lt;/div&gt;&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fillColor=#eeede9;strokeColor=#deded7;strokeWidth=1;fontColor=#242522;fontSize=16;fontFamily=Noto Sans CJK SC;"><mxGeometry as="geometry" x="64" y="928" width="376" height="144" /></mxCell><mxCell id="lib" value="&lt;div style=&quot;font-family:Noto Sans CJK SC;font-size:16px;line-height:1.65;color:#242522&quot;&gt;&lt;div style=&quot;font-size:22px;font-weight:700;line-height:1.3;margin-bottom:8px&quot;&gt;LibraryService&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#62645e;margin-bottom:10px&quot;&gt;liusheng-library · commands = 32&lt;/div&gt;&lt;div&gt;SQLite / 扫描 / 歌单 / 设置 / 会话&lt;/div&gt;&lt;div&gt;LibraryWatcher：notify + 防抖合并&lt;/div&gt;&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fillColor=#ffffff;strokeColor=#deded7;strokeWidth=1;fontColor=#242522;fontSize=16;fontFamily=Noto Sans CJK SC;"><mxGeometry as="geometry" x="560" y="268" width="440" height="176" /></mxCell><mxCell id="search" value="&lt;div style=&quot;font-family:Noto Sans CJK SC;font-size:16px;line-height:1.65;color:#242522&quot;&gt;&lt;div style=&quot;font-size:22px;font-weight:700;line-height:1.3;margin-bottom:8px&quot;&gt;SearchService&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#62645e;margin-bottom:10px&quot;&gt;liusheng-search · latest + wake = 1&lt;/div&gt;&lt;div&gt;共享 TrackRow 快照上的后台过滤&lt;/div&gt;&lt;div&gt;原文 / 拼音 / 首字母 · 排序 / 格式&lt;/div&gt;&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fillColor=#ffffff;strokeColor=#deded7;strokeWidth=1;fontColor=#242522;fontSize=16;fontFamily=Noto Sans CJK SC;"><mxGeometry as="geometry" x="1080" y="268" width="440" height="176" /></mxCe